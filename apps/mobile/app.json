{
  "expo": {
    "name": "Brainrot Learning",
    "slug": "brainrot-learning",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "brainrot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brainrot.learning"
    },
    "android": {
      "package": "com.brainrot.learning",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
