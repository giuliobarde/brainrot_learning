# ─── Brainrot Learning environment variables ────────────────────────────────
# Copy this file to `.env` and fill in real values for local development.
# Never commit `.env` — it is .gitignored.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── MongoDB (Docker compose service) ─────────────────────────────────────────
MONGO_ROOT_USERNAME=brainrot
MONGO_ROOT_PASSWORD=brainrot-dev
MONGO_DATABASE=brainrot
# Connection string the API uses. Override host if Mongo runs elsewhere.
MONGO_URI=mongodb://brainrot:brainrot-dev@localhost:27017/brainrot?authSource=admin

# ── Mongo Express (optional dev UI, started with `--profile tools`) ──────────
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=admin

# ── Auth secrets (generate strong random strings for production) ─────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# ── Hugging Face (free tier inference API) ───────────────────────────────────
# Create a token at https://huggingface.co/settings/tokens (read scope is fine).
HUGGINGFACE_TOKEN=

# ── Storage (where uploaded source files and generated videos are kept) ──────
STORAGE_ROOT=./storage

# ── Mobile app (Expo public env vars) ────────────────────────────────────────
# Anything the app needs at runtime must be prefixed `EXPO_PUBLIC_`.
EXPO_PUBLIC_API_URL=http://localhost:4000
